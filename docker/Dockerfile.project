# Dockerfile.project — per-project ASDD container image.
#
# Hosts the user-driven Claude Code session (interactive mode) and the
# autonomous-mode `asdd-run-job` shim (dispatch mode) against ${ASDD_HOME}.
# Built once by `asdd open` / `asdd dispatch` on first use, reused after.
#
# Image tag: asdd/project:latest

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Base OS packages: git for the CLI's git ops, sops for secret decryption,
# nodejs/npm to host Claude Code. Interactive comfort tooling (vim-tiny,
# less, jq, ripgrep) kept minimal — this is operator-facing, not a dev box.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        jq \
        less \
        nodejs \
        npm \
        ripgrep \
        sqlite3 \
        tmux \
        vim-tiny \
    && rm -rf /var/lib/apt/lists/*

# Match the kernel image's SOPS version so encrypted-secret round-trips are
# byte-compatible between operator and daemon.
ARG SOPS_VERSION=3.9.0
RUN ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL -o /usr/local/bin/sops \
        "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.${ARCH}" \
    && chmod +x /usr/local/bin/sops

# Spec 002 — operator-facing tools (gh, uv, claude) install into the
# baseline directory at /opt/asdd-baseline/. Per-project overlays at
# /home/asdd/.asdd-tools/bin/ (bind-mounted at run time) take precedence
# via PATH ordering — operator upgrades land in the overlay, the baseline
# below is the always-available floor. See specs/002-in-container-tool-upgrades/.
RUN mkdir -p /opt/asdd-baseline/bin /opt/asdd-baseline/versions

# GitHub CLI (gh) — installed into the baseline. Operator upgrades via
# `asdd upgrade gh <project>` (spec 002) land in the per-project overlay.
ARG GH_VERSION=2.94.0
RUN ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL -o /tmp/gh.tar.gz \
        "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${ARCH}.tar.gz" \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${ARCH}/bin/gh" /opt/asdd-baseline/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${ARCH}" \
    && echo "${GH_VERSION}" > /opt/asdd-baseline/versions/gh

# uv — astral.sh package manager. Installed into the baseline.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/opt/asdd-baseline/bin sh \
    && /opt/asdd-baseline/bin/uv --version | awk '{print $2}' > /opt/asdd-baseline/versions/uv

# Claude Code — installed into the baseline npm prefix (NOT /usr/local).
# This is critical: the asdd user (uid 1000) MUST be able to read but the
# files are root-owned; operator upgrades land in the user-writable
# /home/asdd/.asdd-tools/ overlay where PATH resolves first.
RUN npm install -g --prefix=/opt/asdd-baseline @anthropic-ai/claude-code \
    && /opt/asdd-baseline/bin/claude --version | awk '{print $1}' > /opt/asdd-baseline/versions/claude

# Non-root user. UID 1000 matches the host's typical first user so
# bind-mounted files keep sane ownership on macOS via OrbStack/Docker
# Desktop's UID-mapping.
#
# The unix user is named `asdd` (matching the project) rather than
# `operator` because Debian's base image already includes a stock
# `operator` group (legacy POSIX) and useradd refuses to create a
# user-private group with a colliding name.
#
# Recent python:3.12-slim also ships with a stock user at UID 1000
# (typically `ubuntu`) — we remove it first so our useradd succeeds.
RUN if id -u 1000 >/dev/null 2>&1; then \
        userdel -r "$(id -un 1000)" 2>/dev/null || true; \
    fi \
    && useradd --create-home --shell /bin/bash --uid 1000 asdd

WORKDIR /app

# Install the asdd Python package into the image so `asdd new`, `asdd list`,
# etc. work without re-installing inside every container start. The package
# now bundles its own contracts/ subdirectory, so no separate spec COPY is
# needed.
COPY pyproject.toml README.md /app/
COPY asdd/ /app/asdd/
COPY project_skeleton/ /app/project_skeleton/

# In-container job-runner shim for autonomous-mode dispatch (spec 008 US5).
# `asdd dispatch <project> <job-note>` calls this script inside the
# container; it pipes the job-note body through `claude --print` and
# writes the result to /asdd_home/results/<basename>.result.md.
# See docker/files/asdd-run-job.sh for the contract.
# Explicit 0755 (not `chmod +x`, which is umask-sensitive) so the non-root
# `asdd` user can execute it — the source script is mode 0600.
COPY --chmod=0755 docker/files/asdd-run-job.sh /usr/local/bin/asdd-run-job

# Main process for a persistent-mode session container (spec 010): a tmux-held
# interactive `claude --remote-control` the operator can re-attach to locally
# and drive from mobile. Explicit 0755 (source is 0600) so the non-root user
# can execute it.
COPY --chmod=0755 docker/files/asdd-session.sh /usr/local/bin/asdd-session

# Feature 001: in-container shell prompt shows "(project) " when
# ASDD_PROJECT_ID is set. Sourced by Debian's default ~/.bashrc via
# /etc/bash.bashrc for interactive shells.
COPY --chmod=0644 docker/files/asdd-prompt.sh /etc/profile.d/asdd-prompt.sh

# Spec 005 (scrollback-history): global tmux config for operator-attached
# sessions. tmux reads /etc/tmux.conf at server start (the `tmux new-session`
# in asdd-session.sh), so the held claude pane is born with a long
# history-limit and mouse scrolling on — local-terminal-like scrollback.
COPY --chmod=0644 docker/files/asdd-tmux.conf /etc/tmux.conf

RUN pip install --no-cache-dir -e .

# Drop privileges; default shell at /asdd_home so the operator lands in the
# platform's working area on container start.
USER asdd
ENV ASDD_HOME=/asdd_home \
    HOME=/home/asdd \
    PATH=/home/asdd/.asdd-tools/bin:/opt/asdd-baseline/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /asdd_home

# No ENTRYPOINT override — `docker compose run -it operator` (or with
# a trailing `bash` / `claude`) drops the operator into a shell. Explicit
# entrypoint left unset so `docker compose run --rm operator <cmd>` works
# without --entrypoint overrides.
CMD ["bash"]
